<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kote Rocket Crash</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            text-align: center;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 400px;
            margin: 0 auto;
        }
        .rocket-box {
            font-size: 80px;
            margin: 30px 0;
            transition: transform 0.2s ease;
        }
        .multiplier {
            font-size: 48px;
            font-weight: 800;
            color: #38bdf8;
            margin: 10px 0;
        }
        button {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
            border: none;
            padding: 16px 32px;
            font-size: 20px;
            font-weight: bold;
            border-radius: 12px;
            width: 100%;
            cursor: pointer;
            margin-top: 20px;
            box-shadow: 0 4px 14px rgba(34, 197, 94, 0.4);
        }
        button:disabled {
            background: #475569;
            box-shadow: none;
            cursor: not-allowed;
        }
        .status {
            font-size: 16px;
            color: #94a3b8;
            margin-top: 15px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🚀 Kote Crash</h1>
        <div class="rocket-box" id="rocket">🐱🚀</div>
        <div class="multiplier" id="mult">1.00x</div>
        <div class="status" id="status">Tap Launch to start the round!</div>
        
        <button id="actionBtn" onclick="startGame()">LAUNCH ROCKET</button>
    </div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();

        let multiplier = 1.00;
        let gameInterval = null;
        let crashPoint = 1.00;
        let playing = false;

        function startGame() {
            document.getElementById('actionBtn').style.display = 'none'; // hide launch, show claim via dynamic state
            multiplier = 1.00;
            playing = true;
            crashPoint = parseFloat((Math.random() * 10 + 1.2).toFixed(2));
            
            document.getElementById('status').innerText = "Rocket is climbing...";
            
            // Transform button into Claim button
            const btn = document.getElementById('actionBtn');
            btn.innerText = "CLAIM BAG";
            btn.style.background = "linear-gradient(135deg, #eab308, #ca8a04)";
            btn.style.boxShadow = "0 4px 14px rgba(234, 179, 8, 0.4)";
            btn.onclick = claimBag;
            btn.style.display = 'block';

            gameInterval = setInterval(() => {
                multiplier += 0.05 + (multiplier * 0.03);
                if (multiplier >= crashPoint) {
                    multiplier = crashPoint;
                    endGame(true);
                }
                document.getElementById('mult').innerText = multiplier.toFixed(2) + 'x';
                
                // Visual rocket bounce effect
                const rocket = document.getElementById('rocket');
                rocket.style.transform = `translateY(-${Math.min(multiplier * 5, 50)}px)`;
            }, 100);
        }

        function claimBag() {
            if (!playing) return;
            clearInterval(gameInterval);
            playing = false;
            
            document.getElementById('status').innerHTML = `<b style="color: #22c55e;">🎉 Secured Bag at ${multiplier.toFixed(2)}x!</b>`;
            document.getElementById('actionBtn').innerText = "PLAY AGAIN";
            document.getElementById('actionBtn').style.background = "linear-gradient(135deg, #22c55e, #16a34a)";
            document.getElementById('actionBtn').onclick = startGame;
            tg.HapticFeedback.notificationOccurred('success');
        }

        function endGame(crashed) {
            clearInterval(gameInterval);
            playing = false;
            if (crashed) {
                document.getElementById('status').innerHTML = `<b style="color: #ef4444;">💥 RUG-PULLED AT ${crashPoint.toFixed(2)}x!</b>`;
                tg.HapticFeedback.notificationOccurred('error');
            }
            document.getElementById('actionBtn').innerText = "TRY AGAIN";
            document.getElementById('actionBtn').style.background = "linear-gradient(135deg, #ef4444, #dc2626)";
            document.getElementById('actionBtn').onclick = startGame;
        }
    </script>
</body>
</html>
